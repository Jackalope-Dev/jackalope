{
  "name": "jackalope-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Jackalope - Ultra-performant desktop shell and harness for agentic workflows",
  "scripts": {
    "dev": "pnpm --filter @jackalope/desktop dev",
    "build": "pnpm --filter @jackalope/desktop --filter @jackalope/website build",
    "tauri": "pnpm --filter @jackalope/desktop tauri",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . --error-on-warnings",
    "check:write": "biome check --write .",
    "typecheck": "pnpm --filter @jackalope/desktop --filter @jackalope/website typecheck",
    "dev:website": "pnpm --filter @jackalope/website dev",
    "build:website": "pnpm --filter @jackalope/website build",
    "verify": "node scripts/verify.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "licenses:generate": "node scripts/licenses.mjs"
  },
  "keywords": [
    "tauri",
    "rust",
    "desktop",
    "ai-agents",
    "worktrees",
    "kanban",
    "productivity"
  ],
  "author": "Jackalope Contributors",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
