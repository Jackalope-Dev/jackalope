{
  "name": "jackalope-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Jackalope - Ultra-performant desktop shell and harness for agentic workflows",
  "scripts": {
    "prepare": "node scripts/git-hooks.mjs install",
    "hooks:install": "node scripts/git-hooks.mjs install",
    "dev": "pnpm --filter @jackalope/desktop dev",
    "build": "pnpm --filter @jackalope/desktop --filter @jackalope/website build",
    "tauri": "pnpm --filter @jackalope/desktop tauri",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . --error-on-warnings",
    "check:write": "biome check --write .",
    "typecheck": "pnpm --filter @jackalope/ui --filter @jackalope/desktop --filter @jackalope/website typecheck",
    "test": "pnpm test:release && pnpm --filter @jackalope/desktop --filter @jackalope/server test",
    "test:release": "node --test \"scripts/release/*.test.mjs\"",
    "test:hooks": "node --test scripts/git-hooks.test.mjs",
    "dev:website": "pnpm --filter @jackalope/website dev",
    "build:website": "pnpm --filter @jackalope/website build",
    "verify": "node scripts/verify.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:dependencies": "node scripts/security/dependencies.mjs",
    "evaluate:execution": "node scripts/evaluation/run.mjs",
    "evaluate:quality": "node scripts/evaluation/quality.mjs",
    "evaluate:routing": "node scripts/evaluation/routing.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:links:website": "node apps/website/scripts/audit-links.mjs",
    "check:changelog": "node scripts/changelog.mjs check",
    "changelog:add": "node scripts/changelog.mjs add",
    "licenses:generate": "node scripts/licenses.mjs",
    "ui:dev": "pnpm --filter @jackalope/ui dev",
    "ui:build": "pnpm --filter @jackalope/ui build",
    "ui:test": "node scripts/verification/verify-ui.mjs"
  },
  "keywords": [
    "tauri",
    "rust",
    "desktop",
    "ai-agents",
    "worktrees",
    "kanban",
    "productivity"
  ],
  "author": "Jackalope Contributors",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "agent-browser": "0.37.1",
    "lefthook": "2.1.12",
    "playwright-core": "1.63.0"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
