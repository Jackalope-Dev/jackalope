{
  "version": 1,
  "fields": {
    "workflow": {
      "values": ["legacy", "final"],
      "default": "legacy",
      "environment": null
    },
    "task-approach": {
      "values": ["general", "scoped"],
      "default": "general",
      "environment": null
    },
    "tool-surface": {
      "values": ["full", "available"],
      "default": "full",
      "environment": "JACKALOPE_TOOL_SURFACE"
    },
    "named-read": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_NAMED_READ"
