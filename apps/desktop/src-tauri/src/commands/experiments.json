      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_SOURCE_CONTEXT"
    },
    "batch-read": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_BATCH_READ"
