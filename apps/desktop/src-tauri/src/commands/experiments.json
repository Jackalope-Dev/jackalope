    "result-selection": {
      "values": ["on", "off"],
      "default": "on",
      "environment": "JACKALOPE_RESULT_SELECTION"
    },
    "result-queries": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_RESULT_QUERIES"
    },
    "result-preview": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_RESULT_PREVIEW",
