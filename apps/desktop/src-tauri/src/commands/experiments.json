{
  "version": 1,
  "fields": {
    "scope-guard": {
      "values": ["on", "off"],
      "default": "on",
      "environment": "JACKALOPE_SCOPE_GUARD"
    },
    "native-tools": {
      "values": ["off", "bounded"],
      "default": "off",
      "environment": "JACKALOPE_NATIVE_TOOLS"
    },
    "opencode-transport": {
      "values": ["server", "cli"],
      "default": "server",
      "environment": "JACKALOPE_OPENCODE_TRANSPORT"
    },
    "provider-effort": {
      "values": ["on", "off", "low"],
      "default": "on",
      "environment": "JACKALOPE_PROVIDER_EFFORT"
    },
    "learning": {
      "values": ["off", "local", "jev"],
      "default": "off",
      "environment": null
    },
    "workflow": {
      "values": ["legacy", "final"],
      "default": "final",
      "environment": null
    },
    "task-approach": {
      "values": ["general", "scoped"],
      "default": "scoped",
      "environment": null
    },
    "tool-surface": {
      "values": ["full", "available", "deferred"],
      "default": "available",
      "environment": "JACKALOPE_TOOL_SURFACE"
    },
    "named-read": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_NAMED_READ"
    },
    "result-queries": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_RESULT_QUERIES"
    },
    "result-preview": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_RESULT_PREVIEW",
      "requires": {
        "on": {
          "result-queries": "on"
        }
      }
    },
    "initial-tools": {
      "values": ["search", "small"],
      "default": "search",
      "environment": "JACKALOPE_INITIAL_TOOLS"
    },
    "repo-map": {
      "values": ["on", "off"],
      "default": "on",
      "environment": "JACKALOPE_REPO_MAP"
    },
    "context-reuse": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_CONTEXT_REUSE"
    },
    "source-context": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_SOURCE_CONTEXT"
    },
    "context-read": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_CONTEXT_READ"
    },
    "history-compaction": {
      "values": ["off", "deduplicate"],
      "default": "off",
      "environment": "JACKALOPE_HISTORY_COMPACTION"
    },
    "dispatch-plan": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_DISPATCH_PLAN"
    },
    "jev-assistance": {
      "values": ["active", "shadow"],
      "default": "active",
      "environment": "JACKALOPE_JEV_ASSISTANCE"
    },
    "jev-questions": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_JEV_QUESTIONS"
    },
    "context-style": {
      "values": ["off", "compact"],
      "default": "off",
      "environment": "JACKALOPE_CONTEXT_EXPERIMENT"
    },
    "warm-opencode": {
      "values": ["on", "off"],
      "default": "on",
      "environment": "JACKALOPE_WARM_OPENCODE"
    },
    "warm-api-helpers": {
      "values": ["off", "on"],
      "default": "off",
      "environment": "JACKALOPE_WARM_API_HELPERS"
    }
  }
}
