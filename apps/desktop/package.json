{
  "name": "@jackalope/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lab": "vite build --mode lab --outDir dist-lab",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/*.test.mjs\" ../../scripts/release-config.test.mjs ../../scripts/update-manifest.test.mjs",
    "test:file": "node --test",
    "brand:generate": "node scripts/generate-brand.mjs && tauri icon src-tauri/icons/source-icon.svg --ios-color \"#1d1a18\" && node scripts/generate-brand.mjs --copy-icon && pnpm brand:installer",
    "brand:installer": "node scripts/generate-installer-brand.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@jackalope/brand": "workspace:*",
    "@pierre/diffs": "1.4.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@streamdown/code": "1.1.1",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.4.3",
    "streamdown": "2.6.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.0.9",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
