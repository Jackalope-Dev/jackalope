{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jackalope-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker adds Markdown negotiation and discovery headers to pages;
    // hashed build assets and media skip it.
    "run_worker_first": ["/*", "!/assets/*", "!/media/*"]
  },
  "routes": [{ "pattern": "jackalope.dev/*", "zone_name": "jackalope.dev" }]
}
