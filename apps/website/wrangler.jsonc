{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jackalope-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker adds Markdown negotiation and discovery headers to pages;
    // hashed build assets and media skip it.
    "run_worker_first": ["/*", "!/assets/*", "!/media/*"]
  },
  // Per-IP limit for the /api/mcp and /api/a2a content endpoints.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "7301", "simple": { "limit": 60, "period": 60 } }
  ],
  "routes": [{ "pattern": "jackalope.dev/*", "zone_name": "jackalope.dev" }]
}
