{
  "name": "@jackalope/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "pnpm admin:build && tsc --noEmit && tsc -p admin/tsconfig.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply DB --local",
    "admin:build": "node scripts/build-admin.mjs"
  },
  "dependencies": {
    "@jackalope/brand": "workspace:*",
    "jose": "^6.2.12",
    "zod": "4.5.4",
    "@jackalope/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^1.46.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.7",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "4.131.0",
    "esbuild": "0.28.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4"
  }
}
